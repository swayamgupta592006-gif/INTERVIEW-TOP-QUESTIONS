#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);

    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int curr = arr[0];
    int maxi = arr[0];

    for(int i = 1; i < n; i++) {

        curr = max(arr[i], curr + arr[i]);

        maxi = max(maxi, curr);
    }

    cout << maxi << endl;

    return 0;
}